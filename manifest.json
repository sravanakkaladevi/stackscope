{
  "manifest_version": 3,
  "name": "StackScope",
  "version": "1.0.0",
  "description": "Deep tech stack & framework inspector powered by Wappalyzer engine with 3,700+ technology signatures, version extraction, and authentic logos.",
  "permissions": [
    "activeTab",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Scan this page with StackScope",
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["data/domRules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
